# Test harness changes, all behind defines (off by default):
#   MOCK_UART   use the mock UART (instant $write) instead of the 115200-baud UART
#   AES_ENGINE  put the two AES engines (hw/engine: OpenTitan AES + DMA, unmasked
#               and masked) in the GPIO slot at 0x4000_0000, give each a master
#               port on the AXI crossbar, and grow the memory to 16 MB
#   NO_TRACE    do not write instruction traces (about 100 bytes per instruction)

diff --git a/common/local/util/instr_tracer.sv b/common/local/util/instr_tracer.sv
index dad2f29..0f770cb 100644
--- a/common/local/util/instr_tracer.sv
+++ b/common/local/util/instr_tracer.sv
@@ -299,11 +299,13 @@ module instr_tracer #(
   endfunction
 
 
+`ifndef NO_TRACE  // the trace files grow by about 100 bytes per instruction
   initial begin
     #15ns;
     create_file(hart_id_i);
     trace();
   end
+`endif
 
   final begin
     close();
diff --git a/corev_apu/instr_tracing/ITI/cva6_iti/iti.sv b/corev_apu/instr_tracing/ITI/cva6_iti/iti.sv
index c8f6953..24eac74 100644
--- a/corev_apu/instr_tracing/ITI/cva6_iti/iti.sv
+++ b/corev_apu/instr_tracing/ITI/cva6_iti/iti.sv
@@ -31,7 +31,11 @@ module cva6_iti #(
   // pragma translate_off
   int f;
   initial begin
+`ifdef NO_TRACE
+    f = $fopen("/dev/null", "w");
+`else
     f = $fopen("iti.traces", "w");
+`endif
     $fwrite(f, "itype_0,cause,tval,priv,iaddr_0,context,ctype,iretire_0,ilastsize_0\n");
   end
   final $fclose(f);
diff --git a/corev_apu/instr_tracing/rv_encapsulator-main/src/rtl/encapsulator.sv b/corev_apu/instr_tracing/rv_encapsulator-main/src/rtl/encapsulator.sv
